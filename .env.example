# ZentyQuetry Environment Configuration
# COPY file ini ke .env lalu isi dengan nilai asli
# JANGAN commit file .env ke git!

# ------------------------------------------------
# GPlay AI DataBank (diisi di fase integrasi akhir)
# ------------------------------------------------
GPLAY_API_KEY=your_gplay_api_key_here
GPLAY_API_URL=https://gplay.ctar.tech/api/v1

# ------------------------------------------------
# ZentyQuetry Desktop Connector
# ------------------------------------------------
ZENTYQUETRY_LOCAL_PORT=9527
ZENTYQUETRY_LICENSE_PORT=9528
ZENTYQUETRY_INTERNAL_SECRET=your_internal_secret_here

# ------------------------------------------------
# Extension Config
# ------------------------------------------------
EXTENSION_ENV=development
EXTENSION_VERSION=0.1.0
